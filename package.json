{
  "name": "sara",
  "productName": "SARA",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server_full.ts",
    "dev:ui": "vite",
    "test:e2e": "playwright test",
    "build": "npm run lint && vite build && esbuild server_full.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "mobile:init": "npm run build && npx cap add android",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:dev": "npx cap open android",
    "mobile:build": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:apk": "npm run mobile:build",
    "mobile:release": "npm run mobile:sync && cd android && gradlew.bat bundleRelease assembleRelease",
    "mobile-server": "tsx mobile_server.ts",
    "start": "node dist/server.cjs",
    "start:prod": "tsx startup/startupManager.ts",
    "prod": "start-sara-prod.bat",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:agi": "tsx --test agi/*.test.ts tests/agi-layer.test.ts",
    "test:avatar": "tsx --test src/avatar/*.test.ts",
    "clean": "rimraf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "dist": "npm run build && npm run build:agent && electron-builder --win nsis portable && powershell -ExecutionPolicy Bypass -File scripts/test-agent-package.ps1",
    "build:agent": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-agent.ps1",
    "build:all": "npm run dist",
    "build:prod": "powershell -ExecutionPolicy Bypass -File scripts/build-prod.ps1",
    "register-startup": "powershell -ExecutionPolicy Bypass -File scripts/register-startup.ps1",
    "unregister-startup": "powershell -ExecutionPolicy Bypass -File scripts/register-startup.ps1 -Unregister",
    "sara:status": "tsx startup/doctor.ts --status",
    "sara:doctor": "tsx startup/doctor.ts --doctor",
    "sara:stop": "tsx startup/doctor.ts --stop",
    "sara:restart": "tsx startup/doctor.ts --restart",
    "test:real-desktop": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable",
    "test:real-desktop:notepad": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite notepad",
    "test:real-desktop:browser": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite browser",
    "test:real-desktop:mouse": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite mouse",
    "test:real-desktop:keyboard": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite keyboard",
    "desktop:diagnostic": "tsx tests/real-desktop/run-real-desktop-tests.ts --diagnostic",
    "test:autonomous": "tsx tests/real-desktop/closed-loop-acceptance.ts",
    "test:autonomous:real-desktop": "REAL_DESKTOP_TEST=1 tsx tests/real-desktop/closed-loop-acceptance.ts",
    "test:persistence": "tsx tests/persistence-learning.test.ts",
    "test:learning": "tsx tests/persistence-learning.test.ts",
    "test:all": "npm run test:agi && npm run test:avatar && npm run test:security && npm run test:policy && npm run test:agent-auth && npm run test:api && npm run test:chat && npm run test:voice && npm run test:closed-loop && npm run test:autonomous && npm run test:persistence && npm run test:memory && npm run test:learning-records",
    "test:chat": "tsx --test tests/chat-context.test.ts tests/chat-background-memory.test.ts tests/desktop-chat-panel.test.ts tests/context-manager.test.ts tests/api/chat-responsiveness-http.test.ts tests/api/mobile-chat-responsiveness-http.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts src/security/adminAuthAbuse.test.ts src/security/gestureConfig.test.ts src/security/notificationManager.test.ts",
    "test:users": "tsx --test tests/security/multi-user-store.test.ts tests/security/multi-user-preferences.test.ts tests/security/multi-user-webauthn.test.ts tests/security/multi-user-config.test.ts tests/security/private-static-paths.test.ts tests/security/user-session.test.ts tests/security/legacy-server-guard.test.ts tests/api/multi-user-http.test.ts",
    "test:api": "tsx --test tests/api/*.test.ts",
    "test:closed-loop": "tsx --test tests/closed-loop-safety.test.ts tests/task-result-honesty.test.ts tests/task-manager-emergency-stop.test.ts tests/automation-recovery.test.ts src/core/automation/automationOrchestrator.test.ts src/core/tools/initialization.test.ts src/cognitive/taskCancellation.test.ts src/cognitive/integrationBridge.cancellation.test.ts",
    "test:agent-core": "tsx --test tests/approved-memory.test.ts tests/browser-workflow.test.ts tests/api/browser-workflow-http.test.ts tests/api/chat-responsiveness-http.test.ts tests/api/mobile-chat-responsiveness-http.test.ts tests/text-model-router.test.ts tests/task-state-sqlite.test.ts tests/agent-evaluation.test.ts tests/agent-review.test.ts tests/chat-context.test.ts tests/chat-background-memory.test.ts tests/desktop-chat-panel.test.ts tests/context-manager.test.ts tests/voice-background-chat.test.ts tests/window-verifier-background.test.ts src/core/automation/automationOrchestrator.test.ts",
    "eval:agent": "tsx scripts/evaluate-agent.ts",
    "review:agent-eval": "tsx scripts/review-agent-evaluation.ts",
    "test:voice": "tsx --test tests/voice-activity-gate.test.ts tests/voice-background-chat.test.ts tests/window-verifier-background.test.ts src/core/automation/automationOrchestrator.test.ts src/core/identity/voiceIdentity.test.ts src/config/voicePreferences.test.ts",
    "integrity:generate": "node scripts/generate_integrity_manifest.cjs",
    "release:readiness": "tsx scripts/release-readiness.ts",
    "measure:studio": "tsx scripts/measure-studio.ts",
    "measure:evidence": "tsx scripts/measure-evidence.ts",
    "test:memory": "tsx --test tests/memory-management.test.ts",
    "test:learning-records": "tsx --test tests/learning-records.test.ts",
    "test:policy": "tsx --test src/security/approvalBinding.test.ts src/core/tools/policyEngine.test.ts src/core/tools/toolPolicyBoundary.test.ts",
    "test:agent-auth": "tsx --test src/security/desktopAgentAuth.test.ts tests/desktop-agent-auth-health.test.ts tests/screen-verifier.test.ts tests/window-verifier.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-notifier": "^11.0.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.8.0",
    "three": "^0.186.1",
    "uuid": "^11.1.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.40.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/three": "^0.186.0"
  },
  "overrides": {
    "@electron/get": "5.1.0",
    "tar": "7.5.22",
    "image-size": "2.0.4"
  }
}
