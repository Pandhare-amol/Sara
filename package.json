{
  "name": "sara",
  "productName": "SARA",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server_full.ts",
    "test:e2e": "playwright test",
    "build": "vite build && esbuild server_full.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "mobile-server": "tsx mobile_server.ts",
    "start": "node dist/server.cjs",
    "start:prod": "tsx startup/startupManager.ts",
    "prod": "start-sara-prod.bat",
    "preview": "vite preview",
    "clean": "rimraf dist server.js",
    "lint": "tsc --noEmit",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "build:agent": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-agent.ps1",
    "build:all": "npm run build && npm run build:agent && npm run dist",
    "build:prod": "powershell -ExecutionPolicy Bypass -File scripts/build-prod.ps1",
    "register-startup": "powershell -ExecutionPolicy Bypass -File scripts/register-startup.ps1",
    "unregister-startup": "powershell -ExecutionPolicy Bypass -File scripts/register-startup.ps1 -Unregister",
    "sara:status": "tsx startup/doctor.ts --status",
    "sara:doctor": "tsx startup/doctor.ts --doctor",
    "sara:stop": "tsx startup/doctor.ts --stop",
    "sara:restart": "tsx startup/doctor.ts --restart",
    "test:real-desktop": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable",
    "test:real-desktop:notepad": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite notepad",
    "test:real-desktop:browser": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite browser",
    "test:real-desktop:mouse": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite mouse",
    "test:real-desktop:keyboard": "tsx tests/real-desktop/run-real-desktop-tests.ts --enable --suite keyboard",
    "desktop:diagnostic": "tsx tests/real-desktop/run-real-desktop-tests.ts --diagnostic",
    "test:autonomous": "tsx tests/real-desktop/closed-loop-acceptance.ts",
    "test:autonomous:real-desktop": "REAL_DESKTOP_TEST=1 tsx tests/real-desktop/closed-loop-acceptance.ts",
    "test:persistence": "tsx tests/persistence-learning.test.ts",
    "test:learning": "tsx tests/persistence-learning.test.ts",
    "test:all": "npm run test:autonomous && npm run test:persistence"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-notifier": "^10.0.1",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.8.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.40.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
