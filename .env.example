# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional public-data adapters (keep real values only in your ignored .env file).
# Weather uses Open-Meteo without a key by default; OpenWeatherMap is optional.
OPENWEATHER_DEFAULT_API_KEY=
# Optional NewsAPI headlines integration.
NEWSAPI_DEFAULT_API_KEY=
# Optional Alpha Vantage quote integration.
ALPHAVANTAGE_DEFAULT_API_KEY=

# Optional local admin hardening. Set a long random value before using admin
# APIs; first passkey enrollment requires this token or a previously enrolled
# platform passkey session. Do not expose this token in client-side code.
SARA_ADMIN_TOKEN=
# Optional platform authenticator RP settings (usually leave blank for localhost).
SARA_WEBAUTHN_RP_ID=
# Automatic screen lock is OFF by default to prevent lockout/denial-of-service.
# If explicitly enabled, SARA locks the local session after 5 failed admin checks
# from the same address within 5 minutes. Supported: Windows and Linux sessions.
SARA_AUTO_LOCK_ON_AUTH_ABUSE=false
