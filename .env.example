# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional public-data adapters (keep real values only in your ignored .env file).
# Weather uses Open-Meteo without a key by default; OpenWeatherMap is optional.
OPENWEATHER_DEFAULT_API_KEY=
# Optional NewsAPI headlines integration.
NEWSAPI_DEFAULT_API_KEY=
# Optional Alpha Vantage quote integration.
ALPHAVANTAGE_DEFAULT_API_KEY=

# Local service port map (choose distinct values if you already use these ports).
# Keep the backend at 3000, headed Playwright browser agent at 3001, and the
# separately launched mobile service at 3002. Do not stop an unknown listener.
PORT=3000
SARA_BIND_HOST=127.0.0.1
SARA_BROWSER_AGENT_PORT=3001
SARA_BROWSER_AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# YouTube opens in the system default browser by default; "automation" opts into
# SARA's separate Playwright browser, which can verify playback but is not your
# default browser session.
SARA_YOUTUBE_PLAYBACK_TARGET=default
MOBILE_SERVER_PORT=3002
SARA_MOBILE_SERVER_HOST=127.0.0.1
# Managed SARA launchers generate a process-scoped internal agent token in memory
# when unset. Only set this for independently managed Node/Python processes, and
# provide the same 32+ byte secret to both through protected environment config.
SARA_AGENT_INTERNAL_TOKEN=
# For a remote agent only: use HTTPS and configure the same 32+ byte value on
# the agent as SARA_AGENT_ACCESS_TOKEN. Never expose either token to the UI.
SARA_AGENT_ACCESS_TOKEN=
# Electron defaults to 3000 regardless of PORT in .env; to move its backend,
# set SARA_ELECTRON_PORT in the launching shell, e.g. 3003.

# Optional local admin hardening. Set a long random value before using admin
# APIs; first passkey enrollment requires this token or a previously enrolled
# platform passkey session. Do not expose this token in client-side code.
SARA_ADMIN_TOKEN=
# Optional protected multi-user mode. With true, unscoped legacy APIs lock at
# startup, even before account creation. Otherwise activate explicitly in the
# Accounts UI with the local owner secret; activation is not reversible by UI.
# Existing data is backed up without deleting the originals. Configure a text
# provider before activation: protected mode denies /api/config/apikey.
SARA_MULTIUSER_REQUIRED=false
# Optional absolute path for the private data directory. Choose BEFORE account
# activation and use the SAME path for the backend, Electron and Python agent.
# Changing it later without a reviewed migration may lock users out or expose
# a different legacy datastore. Blank uses the platform's existing default.
SARA_DATA_DIR=
# Optional platform authenticator RP settings (usually leave blank for localhost).
# Register over HTTPS, except browser-supported localhost development.
SARA_WEBAUTHN_RP_ID=
# Automatic screen lock is OFF by default to prevent lockout/denial-of-service.
# If explicitly enabled, SARA locks the local session after 5 failed admin checks
# from the same address within 5 minutes. Supported: Windows and Linux sessions.
SARA_AUTO_LOCK_ON_AUTH_ABUSE=false

# Reviewed agent features (backend only; never put model keys in frontend env).
# Gemini remains the default for text; a configured key is still required.
SARA_TEXT_PROVIDER=gemini
SARA_TEXT_MODEL=
# Override one role independently; coding is reserved for future reviewed work.
SARA_PLANNING_PROVIDER=
SARA_PLANNING_MODEL=
SARA_CHAT_PROVIDER=
SARA_CHAT_MODEL=
# For SARA_TEXT_PROVIDER=openai-compatible, set an HTTPS endpoint (or local
# loopback HTTP) and its own model. Keep the API key in an ignored private env.
SARA_TEXT_API_BASE_URL=
SARA_TEXT_API_KEY=
# Backend-wide in-process output-token budget; resets when the server restarts.
SARA_TEXT_OUTPUT_BUDGET=50000
# SARA 13: optional official provider adapters. Subscription/website sessions
# are NOT API credentials. Store secrets only in a private .env or OS vault.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Task-specific roles default to SARA_TEXT_PROVIDER/MODEL unless overridden.
SARA_CODING_PROVIDER=
SARA_CODING_MODEL=
SARA_RESEARCH_PROVIDER=
SARA_RESEARCH_MODEL=
SARA_REASONING_PROVIDER=
SARA_REASONING_MODEL=
SARA_SUMMARIZATION_PROVIDER=
SARA_SUMMARIZATION_MODEL=
SARA_VERIFICATION_PROVIDER=
SARA_VERIFICATION_MODEL=
SARA_CREATION_PROVIDER=
SARA_CREATION_MODEL=
# Optional cost estimates are NOT provider invoices. If you enable the text
# session cost cap, set matching input/output prices for every selected role.
SARA_TEXT_MAX_ESTIMATED_USD=
SARA_GEMINI_INPUT_USD_PER_MILLION=
SARA_GEMINI_OUTPUT_USD_PER_MILLION=
SARA_OPENAI_INPUT_USD_PER_MILLION=
SARA_OPENAI_OUTPUT_USD_PER_MILLION=
SARA_ANTHROPIC_INPUT_USD_PER_MILLION=
SARA_ANTHROPIC_OUTPUT_USD_PER_MILLION=
SARA_OPENAI_COMPATIBLE_INPUT_USD_PER_MILLION=
SARA_OPENAI_COMPATIBLE_OUTPUT_USD_PER_MILLION=
# Research starts only from explicitly approved HTTPS URLs. Source check
# points and opt-in refresh plans are kept under SARA_DATA_DIR/research/.
# The Docker verifier is EXPERIMENTAL, off by default and requires a reviewed,
# locally cached digest-pinned image and manual security testing first.
SARA_ENABLE_DOCKER_SANDBOX=false
SARA_SANDBOX_IMAGE=

# SARA 14: text/Markdown/PDF/code draft uses the role above. Basic parametric
# OBJ meshes are generated locally; no external 3D provider is contacted.
# Image and narration remain OFF until provider, model, cost and daily cap are
# all configured. Confirm pricing and model entitlement with YOUR API account.
SARA_IMAGE_PROVIDER=
SARA_IMAGE_MODEL=
SARA_IMAGE_ESTIMATED_COST_USD=
# Separate opt-in image-edit route: sends a previously saved PNG only after
# owner approval. Original reference is kept unchanged.
SARA_IMAGE_EDIT_PROVIDER=
SARA_IMAGE_EDIT_MODEL=
SARA_IMAGE_EDIT_ESTIMATED_COST_USD=
SARA_AUDIO_PROVIDER=
SARA_AUDIO_MODEL=
SARA_AUDIO_ESTIMATED_COST_USD_PER_1K_CHARS=
SARA_STUDIO_DAILY_ESTIMATED_USD=
# Optional local H.264 MP4 assembly from saved PNGs/WAV, not prompt-to-video.
# Use an absolute path to an owner-reviewed FFmpeg binary with libx264.
SARA_FFMPEG_PATH=

# Inferred memories are off by default and never become approved context.
SARA_AUTO_MEMORY=false
